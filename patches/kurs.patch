+    'room'      => $room ?? null
+  );
+
+print_header($context);
+
+echo "<div id=\"bb-mitsegeln\">\n";
+echo "<h2>Mitsegeln &amp; Kurse</h2>\n";
+echo "<p class=\"bb-intro\">Kommende Fahrten, bei denen Mitsegler willkommen sind, und Kurse. " .
+     "Zum An- oder Abmelden die Fahrt öffnen.</p>\n";
+
+// Filter
+echo "<nav class=\"bb-filter\" aria-label=\"Filter\">\n";
+foreach (['alle' => 'Alle', 'kurse' => 'Kurse', 'mitsegeln' => 'Mitsegeln', 'meine' => 'Meine'] as $key => $label)
+{
+  $cls = ($key === $filter) ? ' class="aktiv" aria-current="page"' : '';
+  echo '<a href="' . escape_html(multisite('bb_mitsegeln.php?filter=' . $key)) . "\"$cls>" . escape_html($label) . "</a>\n";
+}
+echo "</nav>\n";
+
+if (empty($eintraege))
+{
+  $leer = [
+    'alle'      => 'Im Moment gibt es keine Fahrten mit freien Plätzen und keine Kurse.',
+    'kurse'     => 'Im Moment sind keine Kurse geplant.',
+    'mitsegeln' => 'Im Moment sucht niemand Mitsegler.',
+    'meine'     => 'Du hast keine kommenden Buchungen und bist für keine Fahrt angemeldet.'
+  ];
+  echo '<p class="bb-leer">' . escape_html($leer[$filter]) . "</p>\n";
+}
+else
+{
+  echo "<ul class=\"bb-fahrten\">\n";
+  $letzter_tag = '';
+  foreach ($eintraege as $e)
+  {
+    $tag = datetime_format(['pattern' => 'EEEE, d. MMMM'], (int) $e['start_time']);
+    if ($tag !== $letzter_tag)
+    {
+      echo '<li class="bb-tag">' . escape_html($tag) . "</li>\n";
+      $letzter_tag = $tag;
+    }
+
+    $von = datetime_format(['pattern' => 'HH:mm'], (int) $e['start_time']);
+    $bis = datetime_format(['pattern' => 'HH:mm'], (int) $e['end_time']);
+
+    $klassen = ['bb-fahrt', $e['ist_kurs'] ? 'kurs' : ($e['nur_buchung'] ? 'buchung' : 'mitsegeln')];
+    if ($e['voll'])       { $klassen[] = 'voll'; }
+    if ($e['angemeldet']) { $klassen[] = 'angemeldet'; }
+
+    $plaetze = $e['nur_buchung'] ? '' : ($e['limit'] > 0
+      ? ((int) $e['n_registered']) . ' / ' . $e['limit']
+      : ((int) $e['n_registered']) . ' angemeldet');
+
+    if ($e['nur_buchung'])
+    {
+      $status = 'Deine Buchung';
+    }
+    elseif ($e['angemeldet'])
+    {
+      $status = 'Du bist angemeldet';
+    }
+    elseif ($e['eigene'])
+    {
+      $status = 'Deine Fahrt';
+    }
+    elseif ($e['voll'])
+    {
+      $status = 'Voll';
+    }
+    else
+    {
+      $frei = ($e['limit'] > 0) ? ($e['limit'] - (int) $e['n_registered']) : null;
+      $status = isset($frei) ? (($frei === 1) ? '1 Platz frei' : "$frei Plätze frei") : 'Plätze frei';
+    }
+
+    $url = multisite('view_entry.php?id=' . (int) $e['id']);
+    echo '<li class="' . implode(' ', $klassen) . "\">\n";
+    echo '<a href="' . escape_html($url) . "\">\n";
+    echo '<span class="zeit">' . escape_html("$von – $bis") . "</span>\n";
+    echo '<span class="haupt">';
+    echo '<span class="marke">' . ($e['ist_kurs'] ? 'Kurs' : ($e['nur_buchung'] ? 'Buchung' : 'Mitsegeln')) . '</span> ';
+    echo '<span class="boot">' . escape_html($e['room_name']) . '</span>';
+    echo '<span class="leitung">' . ($e['ist_kurs'] ? 'Segellehrer' : 'Schiffsführer') . ': ' .
+         escape_html($e['name']) . '</span>';
+    echo "</span>\n";
+    echo '<span class="plaetze">' . escape_html($plaetze) . '</span>';
+    echo '<span class="status">' . escape_html($status) . "</span>\n";
+    echo "</a>\n</li>\n";
+  }
+  echo "</ul>\n";
+}
+
+echo "</div>\n";
+
+print_footer();
