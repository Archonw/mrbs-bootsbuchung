+<?php
+declare(strict_types=1);
+namespace MRBS;
+
+// =============================================================================
+// Bootsbuchung-Anpassung (warteliste.patch): Warteliste für volle Fahrten und Kurse
+//
+// Tabelle mrbs_bb_warteliste (sql/warteliste.sql). Ist eine Fahrt mit
+// „Mitsegler willkommen“ oder ein Kurs voll, kann man sich eintragen
+// (registration_handler.php, action=warteliste / warteliste_raus; der Knopf
+// kommt aus dem Theme). Wird ein Platz frei, rückt der Erste automatisch nach
+// und bekommt dieselbe Bestätigung wie bei einer normalen Anmeldung.
+// =============================================================================
+
+function bb_warteliste_da() : bool
+{
+  static $da = null;
+  if (!isset($da))
+  {
+    try
+    {
+      db()->query1("SELECT COUNT(*) FROM " . _tbl('bb_warteliste'));
+      $da = true;
+    }
+    catch (\Throwable $e)
+    {
+      $da = false;   // sql/warteliste.sql noch nicht eingespielt
+    }
+  }
+  return $da;
+}
+
+
+// Benutzernamen in der Reihenfolge der Eintragung
+function bb_warteliste(int $entry_id) : array
+{
+  if (!bb_warteliste_da())
+  {
+    return [];
+  }
+  $res = db()->query("SELECT username FROM " . _tbl('bb_warteliste') . " WHERE entry_id=? ORDER BY eingetragen, id",
+                     [$entry_id]);
+  $namen = [];
+  while (false !== ($row = $res->next_row_keyed()))
+  {
+    $namen[] = $row['username'];
+  }
+  return $namen;
+}
+
+
+// Freie Plätze einer Buchung (null = unbegrenzt, 0 = voll)
+function bb_warteliste_frei(array $data) : ?int
+{
+  if (empty($data['registrant_limit_enabled']))
+  {
+    return null;
+  }
+  return max(0, (int) $data['registrant_limit'] - count($data['registrants'] ?? []));
+}
+
+
+function bb_warteliste_eintragen(string $username, int $entry_id) : void
+{
+  if (!bb_warteliste_da())
+  {
+    return;
+  }
+  $data = get_booking_info($entry_id, false);
+  if (empty($data) || empty($data['allow_registration']) || ((int) $data['end_time'] < time()))
+  {
+    return;
+  }
+  $user = session()->getCurrentUser();
+  // nur sich selbst (oder Admins/Segellehrer andere, wie bei der Anmeldung)
+  if (!isset($user) || !(compare_usernames($username, $user->username) === 0 || can_register_others((int) $data['room_id'])))
+  {
+    return;
+  }
+  if (compare_usernames($username, $data['create_by']) === 0 ||
+      in_arrayi($username, array_column($data['registrants'] ?? [], 'username')) ||
+      bb_warteliste_frei($data) !== 0)
+  {
+    return;   // Schiffsführer, schon angemeldet, oder es gibt noch Platz
+  }
+  db()->command("INSERT IGNORE INTO " . _tbl('bb_warteliste') . " (entry_id, username, eingetragen) VALUES (?, ?, ?)",
+                [$entry_id, $username, time()]);
+}
+
+
+function bb_warteliste_austragen(string $username, int $entry_id) : void
+{
+  if (!bb_warteliste_da())
+  {
+    return;
+  }
+  $user = session()->getCurrentUser();
+  $data = get_booking_info($entry_id, false);
+  if (!isset($user) || empty($data) ||
+      !(compare_usernames($username, $user->username) === 0 || can_register_others((int) $data['room_id'])))
+  {
+    return;
+  }
+  db()->command("DELETE FROM " . _tbl('bb_warteliste') . " WHERE entry_id=? AND username=?", [$entry_id, $username]);
+}
+
+
+// Freie Plätze mit der Warteliste auffüllen. Gibt die Nachgerückten zurück.
+function bb_warteliste_nachruecken(int $entry_id) : array
+{
+  if (!bb_warteliste_da())
+  {
+    return [];
+  }
+  $nachgerueckt = [];
+  db()->mutex_lock(_tbl('participants'));
+  try
+  {
+    $data = get_booking_info($entry_id, false);
+    if (empty($data) || empty($data['allow_registration']) || ((int) $data['start_time'] < time()))
+    {
+      return [];
+    }
+    $frei = bb_warteliste_frei($data);
+    $angemeldet = array_column($data['registrants'] ?? [], 'username');
+    foreach (bb_warteliste($entry_id) as $name)
+    {
+      if ($frei !== null && $frei <= 0)
+      {
+        break;
+      }
+      db()->command("DELETE FROM " . _tbl('bb_warteliste') . " WHERE entry_id=? AND username=?", [$entry_id, $name]);
+      if (in_arrayi($name, $angemeldet) || compare_usernames($name, $data['create_by']) === 0)
+      {
+        continue;
+      }
+      add_registrant($entry_id, ['username' => $name, 'create_by' => $name, 'registered' => time()]);
+      $nachgerueckt[] = $name;
+      if ($frei !== null)
+      {
+        $frei--;
+      }
+    }
+  }
+  finally
+  {
+    db()->mutex_unlock(_tbl('participants'));
+  }
+
+  if ($nachgerueckt)
+  {
+    require_once 'bb_kurs.inc';
+    foreach ($nachgerueckt as $name)
+    {
+      bb_anmeldung_mail($entry_id, $name, true);
+    }
+  }
+  return $nachgerueckt;
+}
