+<?php
+declare(strict_types=1);
+namespace MRBS;
+
+use MRBS\Form\Form;
+
+// =============================================================================
+// Bootsbuchung-Anpassung: Buchungszeitraum (Saison) speichern
+//
+// Ziel des Formulars "Buchungszeitraum (Saison)" auf der Seite Verwaltung
+// (admin.php, siehe bb_buchungszeitraum.inc). Nur für Admins: die Seite
+// steht nicht in get_page_level() und fällt damit unter "nur Admins".
+// =============================================================================
+
+require 'defaultincludes.inc';
+require_once 'bb_buchungszeitraum.inc';
+
+Form::checkToken();
+checkAuthorised(this_page());
+
+$beginn = trim((string) get_form_var('saison_beginn', 'string', ''));
+$ende   = trim((string) get_form_var('saison_ende', 'string', ''));
+
+if ((($beginn !== '') && !bb_datum_ok($beginn)) ||
+    (($ende !== '') && !bb_datum_ok($ende)))
+{
+  $status = 'datum';
+}
+elseif (($beginn !== '') && ($ende !== '') && ($ende < $beginn))
+{
+  $status = 'reihenfolge';
+}
+else
+{
+  bb_buchungszeitraum_speichern($beginn, $ende);
+  $status = 'ok';
+}
+
+location_header('admin.php?bz=' . $status . '#bb_buchungszeitraum');
