+<?php
+declare(strict_types=1);
+namespace MRBS;
+
+// =============================================================================
+// Bootsbuchung-Anpassung: Wartungsbericht über alle Boote
+//
+//   bb_wartung_bericht.php?von=JJJJ-MM-TT&bis=…&boot=ID&art=arbeit|meldung
+//                          &status=offen|erledigt&q=Text[&format=csv]
+//
+// Liste aller Einträge aus dem Wartungs-Logbuch (mrbs_bb_wartung) mit
+// Summen für Stunden und Kosten, je Boot und gesamt, als Tabelle oder
+// CSV-Datei (Excel, Semikolon). Lesen dürfen wie beim Logbuch alle
+// angemeldeten Mitglieder. Verlinkt von der Berichtsseite (theme.js) und
+// vom Logbuch (bb_wartung.php).
+// =============================================================================
+
+require "defaultincludes.inc";
+require_once "bb_wartung.inc";
+
+checkAuthorised('search.php');
+
+$heute = date('Y-m-d');
+$datum = function (string $name, string $vorgabe) : string {
+  $v = (string) get_form_var($name, 'string');
+  return preg_match('/^\d{4}-\d{2}-\d{2}$/', $v) ? $v : $vorgabe;
+};
+$von    = $datum('von', date('Y') . '-01-01');
+$bis    = $datum('bis', $heute);
+$boot   = get_form_var('boot', 'int');
+$art    = (string) get_form_var('art', 'string');
+$status = (string) get_form_var('status', 'string');
+$q      = trim((string) get_form_var('q', 'string'));
+$csv    = (get_form_var('format', 'string') === 'csv');
+$aktiv  = bb_wartung_aktiv();
+$mit_behebung = bb_wartung_behebung_aktiv();
+
+// Boote für die Auswahl
+$boote = [];
+$res = db()->query("SELECT R.id, R.room_name
+                      FROM " . _tbl('room') . " R, " . _tbl('area') . " A
+                     WHERE A.id=R.area_id AND R.disabled=0 AND A.disabled=0
+                  ORDER BY R.room_name");
+while (false !== ($row = $res->next_row_keyed()))
+{
+  $boote[(int) $row['id']] = $row['room_name'];
+}
+
+// Einträge nach Filter
+$eintraege = [];
+if ($aktiv)
+{
+  $sql = "SELECT W.*, R.room_name
+            FROM " . _tbl('bb_wartung') . " W, " . _tbl('room') . " R
+           WHERE R.id=W.room_id AND W.datum>=? AND W.datum<=?";
+  $params = [$von, $bis];
+  if (isset($boot) && isset($boote[$boot]))
+  {
+    $sql .= " AND W.room_id=?";
+    $params[] = $boot;
+  }
+  if ($art === 'meldung')
+  {
+    $sql .= " AND W.art='meldung'";
+  }
+  elseif ($art === 'arbeit')
+  {
+    $sql .= " AND W.art<>'meldung'";
+  }
+  if ($status === 'offen')
+  {
+    $sql .= " AND W.erledigt=0";
+  }
+  elseif ($status === 'erledigt')
+  {
+    $sql .= " AND W.erledigt<>0";
+  }
+  if ($q !== '')
+  {
+    $felder = ['W.arbeit', 'W.material', 'W.erledigt_von', 'W.gemeldet_von'];
+    if ($mit_behebung)
+    {
+      $felder[] = 'W.behebung';
+    }
+    $sql .= " AND (" . implode(' OR ', array_map(function ($f) {
+              return "$f LIKE ?";
+            }, $felder)) . ")";
+    $muster = '%' . addcslashes($q, '%_\\') . '%';
+    foreach ($felder as $f)
+    {
+      $params[] = $muster;
+    }
+  }
+  $sql .= " ORDER BY W.datum DESC, R.room_name, W.id DESC";
+  $res = db()->query($sql, $params);
+  while (false !== ($row = $res->next_row_keyed()))
+  {
+    $eintraege[] = $row;
+  }
+}
