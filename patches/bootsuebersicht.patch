+$status_text = function (array $e) : string {
+  $offen = empty($e['erledigt']);
+  return bb_ist_meldung($e) ? ($offen ? 'offen' : 'behoben') : ($offen ? 'offen' : 'erledigt');
+};
+
+// Summen je Boot und gesamt
+$summen = [];
+$gesamt = ['n' => 0, 'stunden' => 0.0, 'kosten' => 0.0, 'offen' => 0];
+foreach ($eintraege as $e)
+{
+  $name = $e['room_name'];
+  $summen[$name] = $summen[$name] ?? ['n' => 0, 'stunden' => 0.0, 'kosten' => 0.0, 'offen' => 0];
+  foreach ([&$summen[$name], &$gesamt] as &$s)
+  {
+    $s['n']++;
+    $s['stunden'] += (float) ($e['stunden'] ?? 0);
+    $s['kosten']  += (float) ($e['kosten'] ?? 0);
+    $s['offen']   += empty($e['erledigt']) ? 1 : 0;
+  }
+  unset($s);
+}
+ksort($summen, SORT_NATURAL | SORT_FLAG_CASE);
