+// Bootsbuchung-Anpassung: teilt einen Anzeigenamen in Vorname und Nachname (das letzte Wort)
+function bb_namensteile(string $name) : array
+{
+  $name = trim($name);
+  if (preg_match('/^(.*\S)\s+(\S+)$/u', $name, $m))
+  {
+    return array($m[1], $m[2]);
+  }
+  return array($name, '');
+}
